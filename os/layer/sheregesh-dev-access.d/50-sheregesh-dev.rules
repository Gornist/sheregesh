// Dev-образ: пользователь sheregesh-ui без root и sudo может только
// останавливать/запускать/перезапускать лабораторные службы «Шерегеша» и слать им сигнал (S2-4б, S3.1, S5 LS-6;
// set-property и прочие глаголы — нет) и перезагружать плату,
// в том числе в tryboot (S2-5), и штатно выключать её (S2-BOOT).
// S3.1-DEPLOY: ещё только ЗАПУСК (verb "start") трёх экземпляров установщика подписанных выпусков приложения
// sheregesh-deploy@{install,rollback,factory}.service — без параметров, команд и путей. Других прав нет.
polkit.addRule(function(action, subject) {
    if (subject.user != "sheregesh-ui") { return polkit.Result.NOT_HANDLED; }
    if (action.id == "org.freedesktop.systemd1.manage-units") {
        var unit = action.lookup("unit");
        var verb = action.lookup("verb");
        // S5 LS-6: только управление ходом служб (в т. ч. kill — SIGHUP главному процессу для перечитывания
        // video-input.json); set-property, clean, freeze и прочие — нет (set-property снял бы песочницу и IPAddressDeny).
        var run = ["start", "stop", "restart", "try-restart", "reload-or-restart", "kill", "reset-failed"];
        if ((unit == "sheregesh-console.service" || unit == "sheregesh-remote-emu.service" ||
             unit == "sheregesh-remote-net.service" || unit == "sheregesh-health.service" ||
             unit == "sheregesh-video-tx.service" || unit == "sheregesh-video-rx.service") && run.indexOf(verb) >= 0) {
            return polkit.Result.YES;
        }
        if ((unit == "sheregesh-deploy@install.service" || unit == "sheregesh-deploy@rollback.service" ||
             unit == "sheregesh-deploy@factory.service") && action.lookup("verb") == "start") {
            return polkit.Result.YES;
        }
    }
    if (action.id == "org.freedesktop.login1.reboot" || action.id == "org.freedesktop.login1.reboot-multiple-sessions" ||
        action.id == "org.freedesktop.login1.set-reboot-parameter" ||
        action.id == "org.freedesktop.login1.power-off" || action.id == "org.freedesktop.login1.power-off-multiple-sessions") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
