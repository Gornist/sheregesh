#!/usr/bin/python3
# SPDX-FileCopyrightText: 2026 Sheregesh contributors
# SPDX-License-Identifier: GPL-3.0-or-later
"""Время между платами без интернета (ADR-0017): пульт — источник времени блока, chrony на обеих. Запускается от root
юнитами sheregesh-time-role.service (после chrony.service) и sheregesh-time-peer@<экземпляр>.service; sheregesh-ui
может только «start» второго (polkit). chrony.conf образа ролей не знает: источники — файлы в sourcedir
/run/sheregesh-time/sources (имена резолвит сам chronyd — с повторами, без интернета не ломается), применяются
`chronyc reload sources`; через chronyc — только local, allow и reload (без DNS: песочница юнита — только AF_UNIX).

  sheregesh-time role          — по роли платы и peer_hosts из link.json:
                                 пульт: пул Debian (если интернет есть), local stratum 10 (если нет), allow peer_hosts;
                                 блок: источник — только пульт (peer_hosts), без пула: часы плат согласованы между собой
  sheregesh-time peer АДРЕС    — адрес второй платы текущего сеанса (DHCP может отличаться от peer_hosts):
                                 пульт: allow АДРЕС; блок: источник АДРЕС (файл session.sources заменяется)
  sheregesh-time peer none     — блок: сеансового источника нет; пульт: ничего
  sheregesh-time save          — часы без RTC (как fake-hwclock): mtime drift-файла chrony = сейчас, только вперёд;
                                 при загрузке chronyd -s ставит часы по этому mtime (таймер раз в 10 мин и остановка)

Адрес — строго один IPv4/IPv6 без маски и зоны, не unspecified и не multicast (как sheregesh-video-allow). Коды: 0 —
применено (или у платы нет роли), 1 — chronyc отказал или не найден, 2 — недопустимые аргументы. chronyc — списком,
без shell."""
import ipaddress
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

CHRONYC = "/usr/bin/chronyc"
SOCKET = "/run/chrony/chronyd.sock"               # только локальный сокет: без него chronyc пробует UDP 127.0.0.1/::1
CONFIG = Path("/home/sheregesh-ui/.config/sheregesh")
SOURCES = Path("/run/sheregesh-time/sources")    # sourcedir chrony.conf (RuntimeDirectory юнита role, 0755)
POOL = "2.debian.pool.ntp.org"
LOCAL_STRATUM = 10                                # ниже любого реального источника: при интернете выбирается пул
POLL = ("minpoll", "4", "maxpoll", "6")           # 16–64 с: быстрое схождение в лабораторной сети
MAX_LEN = 45
CHARS = re.compile(r"[0-9a-fA-F:.]+")
DRIFT = Path("/persistent/chrony/chrony.drift")    # driftfile chrony.conf образа
DRIFT_NEW = "0.000000 100000.000000\n"            # частота 0, погрешность велика: chrony оценит заново


def parse(instance):
    """'none' → None; адрес → ipaddress-объект; иначе ValueError."""
    if not isinstance(instance, str) or not 0 < len(instance) <= MAX_LEN:
        raise ValueError("недопустимая длина экземпляра")
    if instance == "none":
        return None
    if not CHARS.fullmatch(instance):
        raise ValueError("недопустимые символы в адресе")
    addr = ipaddress.ip_address(instance)
    if addr.is_unspecified or addr.is_multicast:
        raise ValueError("адрес не может быть unspecified или multicast")
    return addr


def role(config=CONFIG):
    """console | remote | None по файлам *.role (как confirm.role)."""
    found = [r for r in ("console", "remote") if (config / f"{r}.role").exists()]
    return found[0] if len(found) == 1 else None


def peer_hosts(config=CONFIG):
    """Допустимые адреса из link.json peer_hosts; имена и мусор пропускаются."""
    try:
        hosts = json.loads((config / "link.json").read_text()).get("peer_hosts") or []
    except (OSError, ValueError, AttributeError):
        return []
    out = []
    for h in hosts if isinstance(hosts, list) else []:
        try:
            a = parse(h)
        except ValueError:
            continue
        if a is not None and a.compressed not in out:
            out.append(a.compressed)
    return out


def role_plan(r, hosts):
    """(строки role.sources, команды chronyc) для роли платы."""
    if r == "console":
        return [f"pool {POOL} iburst"], ([["local", "stratum", str(LOCAL_STRATUM)]] + [["allow", h] for h in hosts]
                                         + [["reload", "sources"]])
    if r == "remote":
        return [" ".join(["server", h, "iburst", *POLL]) for h in hosts], [["reload", "sources"]]
    return None, []


def peer_plan(r, addr, hosts):
    """(строки session.sources или None — файл не трогать, команды chronyc) для сеансового адреса."""
    if r == "console":
        return None, ([] if addr is None else [["allow", addr]])
    if r == "remote":
        lines = [] if addr is None or addr in hosts else [" ".join(["server", addr, "iburst", *POLL])]
        return lines, [["reload", "sources"]]
    return None, []


def write_sources(sources, name, lines):
    """Файл источников chrony атомарно (временный + rename), 0644: chronyd читает его от _chrony."""
    sources.mkdir(mode=0o755, parents=True, exist_ok=True)
    tmp = sources / f".{name}.tmp"
    tmp.write_text("".join(f"{x}\n" for x in lines))
    tmp.chmod(0o644)
    os.replace(tmp, sources / name)


def save(drift=DRIFT, now=None):
    """mtime drift-файла → сейчас, если сейчас позже (часы назад не переводятся). Нет файла — создать (каталог есть):
    иначе плата, ни разу не синхронизированная, после перезагрузки вернулась бы к времени сборки."""
    now = time.time() if now is None else now
    if not drift.parent.is_dir():
        print(f"sheregesh-time: нет каталога {drift.parent}", file=sys.stderr)
        return 1
    try:
        created = not drift.exists()
        if created:
            drift.write_text(DRIFT_NEW)
            shutil.chown(drift, drift.parent.stat().st_uid, drift.parent.stat().st_gid)
        if created or drift.stat().st_mtime < now:
            os.utime(drift, (now, now))
    except OSError as e:
        print(f"sheregesh-time: отметка времени не записана: {type(e).__name__}", file=sys.stderr)
        return 1
    print(f"sheregesh-time: отметка {time.strftime('%F %T', time.gmtime(drift.stat().st_mtime))} UTC")
    return 0


def run_chronyc(args):
    return subprocess.run([CHRONYC, "-h", SOCKET, *args], capture_output=True, text=True, timeout=10, check=False)


def apply(cmds, runner):
    for args in cmds:
        try:
            r = runner(args)
        except (OSError, subprocess.SubprocessError) as e:
            print(f"sheregesh-time: chronyc не выполнен: {type(e).__name__}", file=sys.stderr)
            return 1
        out = f"{r.stdout or ''} {r.stderr or ''}".strip()
        if r.returncode != 0:
            print(f"sheregesh-time: chronyc {' '.join(args)}: код {r.returncode}: {out[:200]}", file=sys.stderr)
            return 1
        print(f"sheregesh-time: chronyc {' '.join(args)}")
    return 0


def main(argv=None, runner=run_chronyc, config=CONFIG, sources=SOURCES, drift=DRIFT):
    argv = sys.argv[1:] if argv is None else argv
    if not argv or argv[0] not in ("role", "peer", "save") or len(argv) != (2 if argv[0] == "peer" else 1):
        print("sheregesh-time: role | peer АДРЕС|none | save", file=sys.stderr)
        return 2
    if argv[0] == "save":
        return save(drift)
    addr = None
    if argv[0] == "peer":
        try:
            a = parse(argv[1])
        except ValueError as e:
            print(f"sheregesh-time: отказ: {e}", file=sys.stderr)
            return 2
        addr = None if a is None else a.compressed
    r = role(config)
    if r is None:
        print("sheregesh-time: роль платы не задана — chrony без источников сеанса")
        return 0
    hosts = peer_hosts(config)
    name, (lines, cmds) = ("role.sources", role_plan(r, hosts)) if argv[0] == "role" else \
        ("session.sources", peer_plan(r, addr, hosts))
    if lines is not None:
        try:
            write_sources(sources, name, lines)
        except OSError as e:
            print(f"sheregesh-time: {name} не записан: {type(e).__name__}", file=sys.stderr)
            return 1
    return apply(cmds, runner)


if __name__ == "__main__":
    sys.exit(main())
