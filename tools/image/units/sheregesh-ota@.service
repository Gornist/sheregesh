# Одно соединение с агентом обновления A/B (root): фиксированные действия status | install | enable | disable |
# tryboot | confirm | abort. Пишет только неактивный слот, /persistent/slots/<неактивный>/var,
# /persistent/sheregesh-ota и (при подписанном разрешении) autoboot.txt. Код — всегда из /usr.
[Unit]
Description=Sheregesh: A/B system update agent (connection)
RequiresMountsFor=/persistent /bootfs

[Service]
ExecStart=/usr/bin/sheregesh-ota-agent serve
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=2h
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
Environment=PYTHONDONTWRITEBYTECODE=1
