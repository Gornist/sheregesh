# Таблица nftables видео пульта (ADR-0016 §3.3, контракт §8): UDP-порты 7444 и 7445 — только с адреса, который ставит
# sheregesh-video-allow@. Роль console. Наборы при загрузке пусты. Ошибка загрузки — юнит failed, и sheregesh-video-rx
# (Requires=) не стартует. After=nftables.service: штатный /etc/nftables.conf начинается с «flush ruleset» и стёр бы таблицу.
# Блок (роль remote) загружает свой вариант — sheregesh-video-nft-remote.service.
[Unit]
Description=Sheregesh: video firewall table (console, UDP 7444/7445 peer only)
Before=network-pre.target sheregesh-video-rx.service
After=local-fs.target nftables.service
ConditionPathExists=!/home/sheregesh-ui/.config/sheregesh/remote.role

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
ExecStart=/usr/sbin/nft -f /usr/share/sheregesh/nft/sheregesh-video-console.nft
ExecStop=-/usr/sbin/nft delete table inet sheregesh_video
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
