"""Эмулированные входы vivid на плате без root и без v4l-utils (ioctl напрямую; группа video).

  lab-vivid init                               петли «выход → вход», PAL, 1280x720p30, без OSD
  lab-vivid status
  lab-vivid cvbs|hdmi ok|nosignal|nolock|cable-out|testpattern
  lab-vivid hdmi outofrange
  lab-vivid cvbs pal|ntsc                      стандарт (подача sheregesh-lab-vivid-feed@cvbs перезапускается)
  lab-vivid hdmi 1920x1080p30                  режим HDMI (подача @hdmi перезапускается)
  lab-vivid feed cvbs|hdmi [CONF]              подача камеры (SHCAM_RTSP) в выход vivid — для юнита подачи

Узлы ищутся по имени в sysfs (vivid-000-vid-cap …), не по номеру. Что при этом видит V4L2 — tools/lab-video/CONTRACT.md.
Перезапуск подачи — через systemctl (polkit разрешает sheregesh-ui stop/start юнитов подачи).
"""
import fcntl
import os
import re
import shlex
import struct
import subprocess
import sys
from pathlib import Path

SYS = Path("/sys/class/video4linux")
NODES = {("cvbs", "cap"): "vivid-000-vid-cap", ("cvbs", "out"): "vivid-000-vid-out",
         ("hdmi", "cap"): "vivid-001-vid-cap", ("hdmi", "out"): "vivid-001-vid-out"}
STD = {"pal": 0x000000FF, "ntsc": 0x0000B000}
SIGNAL = {  # режим → (значение *_signal_mode, значение *_is_connected_to)
    "ok": (0, 2), "nosignal": (1, 2), "nolock": (2, 2), "outofrange": (3, 2), "cable-out": (0, 1), "testpattern": (0, 0)}


def _ioc(d, nr, size):
    return (d << 30) | (size << 16) | (ord("V") << 8) | nr


VIDIOC_G_CTRL, VIDIOC_S_CTRL = _ioc(3, 27, 8), _ioc(3, 28, 8)
VIDIOC_QUERYCTRL = _ioc(3, 36, 68)
VIDIOC_G_STD, VIDIOC_S_STD = _ioc(2, 23, 8), _ioc(1, 24, 8)
VIDIOC_S_DV_TIMINGS, VIDIOC_G_DV_TIMINGS = _ioc(3, 87, 132), _ioc(3, 88, 132)
VIDIOC_ENUM_DV_TIMINGS = _ioc(3, 98, 148)
NEXT_CTRL = 0x80000000


def node(kind, role, sys_root=SYS):
    want = NODES[(kind, role)]
    for d in sorted(sys_root.glob("video*")):
        try:
            if (d / "name").read_text().strip() == want:
                return Path("/dev") / d.name
        except OSError:
            continue
    raise SystemExit(f"lab-vivid: нет узла {want} — vivid не загружен (systemctl start sheregesh-lab-vivid)")


def norm(name):
    return re.sub(r"[^a-z0-9]+", "_", name.lower()).strip("_")


def controls(fd):
    """{нормализованное имя: id} — как имена v4l2-ctl (s_video_000_0_is_connected_to …)."""
    out, cid = {}, NEXT_CTRL
    while True:
        q = bytearray(68)
        struct.pack_into("I", q, 0, cid)
        try:
            fcntl.ioctl(fd, VIDIOC_QUERYCTRL, q)
        except OSError:
            return out
        qid = struct.unpack_from("I", q)[0]
        out[norm(q[8:40].split(b"\0")[0].decode())] = qid
        cid = qid | NEXT_CTRL


def set_ctrl(fd, ids, suffix, value):
    name = next((n for n in ids if n.endswith(suffix)), None)
    if name is None:
        raise SystemExit(f"lab-vivid: нет управления *{suffix}")
    fcntl.ioctl(fd, VIDIOC_S_CTRL, struct.pack("Ii", ids[name], value))


def get_ctrl(fd, ids, suffix):
    name = next((n for n in ids if n.endswith(suffix)), None)
    if name is None:
        return None
    b = bytearray(struct.pack("Ii", ids[name], 0))
    fcntl.ioctl(fd, VIDIOC_G_CTRL, b)
    return struct.unpack("Ii", b)[1]


def set_signal(kind, mode):
    if mode == "outofrange" and kind != "hdmi":
        raise SystemExit("lab-vivid: outofrange — только hdmi")
    sig, conn = SIGNAL[mode]
    fd = os.open(node(kind, "cap"), os.O_RDWR)
    try:
        ids = controls(fd)
        set_ctrl(fd, ids, "standard_signal_mode" if kind == "cvbs" else "dv_timings_signal_mode", sig)
        set_ctrl(fd, ids, "_is_connected_to", conn)
    finally:
        os.close(fd)


def bt_fps(dv):
    """(ширина, высота, кадров/с, чересстрочно) из struct v4l2_dv_timings (type + v4l2_bt_timings, packed)."""
    w, h, il, _pol, pclk, hfp, hs, hbp, vfp, vs, vbp, ivfp, ivs, ivbp = struct.unpack_from("<IIIIQIIIIIIIII", dv, 4)
    tw, th = w + hfp + hs + hbp, h + vfp + vs + vbp + (ivfp + ivs + ivbp if il else 0)
    return w, h, (pclk / (tw * th)) if tw and th else 0.0, bool(il)          # кадров (не полей) в секунду


def find_timings(fd, w, h, fps):
    i = 0
    while True:
        e = bytearray(148)
        struct.pack_into("I", e, 0, i)
        try:
            fcntl.ioctl(fd, VIDIOC_ENUM_DV_TIMINGS, e)
        except OSError:
            raise SystemExit(f"lab-vivid: vivid не знает режим {w}x{h}p{fps}") from None
        dv = bytes(e[16:])
        tw, th, tf, il = bt_fps(dv)
        if (tw, th) == (w, h) and not il and round(tf) == fps:
            return dv
        i += 1


def feed_unit(kind, verb):
    subprocess.run(["systemctl", verb, f"sheregesh-lab-vivid-feed@{kind}.service"], check=False)


def feed_active(kind):
    return subprocess.run(["systemctl", "is-active", "-q", f"sheregesh-lab-vivid-feed@{kind}.service"]).returncode == 0


def with_feed_stopped(kind, fn):
    was = feed_active(kind)
    if was:
        feed_unit(kind, "stop")
    try:
        fn()
    finally:
        if was:
            feed_unit(kind, "start")


def set_std(std):
    def apply():
        for role in ("cap", "out"):
            fd = os.open(node("cvbs", role), os.O_RDWR)
            try:
                fcntl.ioctl(fd, VIDIOC_S_STD, struct.pack("Q", STD[std]))
            finally:
                os.close(fd)
    with_feed_stopped("cvbs", apply)


def set_hdmi(mode):
    m = re.fullmatch(r"(\d+)x(\d+)p(\d+)", mode)
    if not m:
        raise SystemExit(f"lab-vivid: режим HDMI вида 1280x720p30: {mode}")
    w, h, fps = map(int, m.groups())

    def apply():
        for role in ("out", "cap"):
            fd = os.open(node("hdmi", role), os.O_RDWR)
            try:
                dv = bytearray(find_timings(fd, w, h, fps))
                fcntl.ioctl(fd, VIDIOC_S_DV_TIMINGS, dv)
            finally:
                os.close(fd)
    with_feed_stopped("hdmi", apply)


def status():
    for kind in ("cvbs", "hdmi"):
        cap = node(kind, "cap")
        fd = os.open(cap, os.O_RDWR)
        try:
            ids = controls(fd)
            if kind == "cvbs":
                b = bytearray(8)
                fcntl.ioctl(fd, VIDIOC_G_STD, b)
                std = struct.unpack("Q", b)[0]
                mode = "PAL" if std & 0xFF else "NTSC" if std & 0xB000 else hex(std)
                sig = get_ctrl(fd, ids, "standard_signal_mode")
            else:
                b = bytearray(132)
                fcntl.ioctl(fd, VIDIOC_G_DV_TIMINGS, b)
                w, h, f, _il = bt_fps(bytes(b))
                mode, sig = f"{w}x{h}p{f:.2f}", get_ctrl(fd, ids, "dv_timings_signal_mode")
            conn = get_ctrl(fd, ids, "_is_connected_to")
        finally:
            os.close(fd)
        print(f"{kind}: {cap} {mode}  signal_mode={sig} connected_to={conn}  feed={'active' if feed_active(kind) else 'inactive'}")


def feed_pipeline(kind, src_url, decoder):
    """Конвейер gst-launch: поток камеры → формат узла vivid-выхода (как shcam-feed). Аналог: чересстрочно по
    стандарту; capssetter убирает field-order, иначе поле выхода (Interlaced-TB/BT) не совпадёт со входом."""
    src = (f"rtspsrc location={src_url} protocols=tcp latency=0 ! rtph264depay ! h264parse ! {decoder} "
           "! videoconvert ! videoscale add-borders=false ! videorate")
    out = node(kind, "out")
    fd = os.open(out, os.O_RDWR)
    try:
        if kind == "cvbs":
            b = bytearray(8)
            fcntl.ioctl(fd, VIDIOC_G_STD, b)
            pal = bool(struct.unpack("Q", b)[0] & 0xFF)
        else:
            b = bytearray(132)
            fcntl.ioctl(fd, VIDIOC_G_DV_TIMINGS, b)
            w, h, f, _il = bt_fps(bytes(b))
    finally:
        os.close(fd)
    if kind == "cvbs":
        w, h, fields, rate, par, tff, label = ((720, 576, "50/1", "25/1", "54/59", "true", "CVBS PAL") if pal else
                                               (720, 480, "60000/1001", "30000/1001", "11/10", "false", "CVBS NTSC"))
        return (f"{src} ! video/x-raw,width={w},height={h},framerate={fields},pixel-aspect-ratio={par} "
                f'! timeoverlay text="{label}" halignment=right valignment=bottom '
                f"! videoconvert ! video/x-raw,format=YUY2 ! interlace field-pattern=1:1 top-field-first={tff} "
                f'! capssetter replace=true caps="video/x-raw,format=YUY2,width={w},height={h},framerate={rate},'
                f'interlace-mode=interleaved,pixel-aspect-ratio={par}" ! v4l2sink device={out} sync=false')
    r = round(f)
    rate = f"{r * 1000}/1001" if r - f > 0.005 else f"{r}/1"
    return (f"{src} ! video/x-raw,width={w},height={h},framerate={rate} "
            f'! timeoverlay text="HDMI {w}x{h}" halignment=right valignment=bottom '
            f"! videoconvert ! video/x-raw,format=YUY2 ! v4l2sink device={out} sync=false")


def feed(kind, conf_path="/etc/sheregesh/lab-video.conf"):
    conf = dict(ln.split("=", 1) for ln in Path(conf_path).read_text().splitlines()
                if "=" in ln and not ln.lstrip().startswith("#"))
    url = conf.get("SHCAM_RTSP", "").strip()
    if not url.startswith("rtsp://"):
        raise SystemExit(f"lab-vivid: SHCAM_RTSP в {conf_path}: {url!r}")
    # Pi 4: аппаратный v4l2h264dec (avdec_h264 в образе нет); Pi 5 / x86: avdec_h264
    dec = "v4l2h264dec" if subprocess.run(["gst-inspect-1.0", "v4l2h264dec"], capture_output=True).returncode == 0 \
        else "avdec_h264"
    args = ["gst-launch-1.0", "-q", *shlex.split(feed_pipeline(kind, url, dec))]
    os.execvp(args[0], args)


def init():
    for kind in ("cvbs", "hdmi"):
        fd = os.open(node(kind, "cap"), os.O_RDWR)
        try:
            set_ctrl(fd, controls(fd), "osd_text_mode", 2)
        finally:
            os.close(fd)
    set_std("pal")
    set_hdmi("1280x720p30")
    set_signal("cvbs", "ok")
    set_signal("hdmi", "ok")


def main(argv):
    if not argv or argv[0] == "status":
        status()
    elif argv[0] == "init":
        init()
    elif argv[0] == "feed" and len(argv) in (2, 3) and argv[1] in ("cvbs", "hdmi"):
        feed(*argv[1:])
    elif argv[0] in ("cvbs", "hdmi") and len(argv) == 2:
        kind, arg = argv
        if arg in SIGNAL:
            set_signal(kind, arg)
        elif kind == "cvbs" and arg in STD:
            set_std(arg)
        elif kind == "hdmi" and re.fullmatch(r"\d+x\d+p\d+", arg):
            set_hdmi(arg)
        else:
            raise SystemExit(f"lab-vivid: неизвестно {kind} {arg}")
    else:
        print(__doc__.split("\n\n")[1])
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
