#!/usr/bin/python3 -I
# SPDX-FileCopyrightText: 2026 Sheregesh contributors
# SPDX-License-Identifier: GPL-3.0-or-later
"""Помощник root для лабораторных источников видео блока (только dev-образ; п. 7 tools/lab-video).

Запускается только юнитами systemd с фиксированными аргументами; sheregesh-ui вызывает его не напрямую, а через
polkit — «start/stop/restart» перечисленных юнитов (51-sheregesh-lab-video.rules). Параметров от пользователя нет.

  sheregesh-lab-video vivid start|stop          загрузить / выгрузить vivid (параметры — /etc/modprobe.d)
  sheregesh-lab-video usbip start|stop SLOT     подключить / отключить устройство эмулятора shcam
                                                SLOT: hdmi (1-1, 534d:2109) | cvbs (1-2, 534d:0021) | camera (1-3)

USB/IP подключается только к SHCAM_HOST из /etc/sheregesh/lab-video.conf (root), и только если это IPv4 из
LAB_NET: подключённое по сети USB-устройство попадает в USB-стек ядра, поэтому сервер задаётся образом, а не
пользователем. Порт vhci запоминается в $RUNTIME_DIRECTORY/port для stop.
"""
import argparse
import ipaddress
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import usbip_attach  # noqa: E402  (рядом в /usr/lib/sheregesh/lab-video)

CONF = Path("/etc/sheregesh/lab-video.conf")
SLOTS = {"hdmi": "1-1", "cvbs": "1-2", "camera": "1-3"}


class Refused(Exception):
    pass


def read_conf(path):
    conf = {}
    for line in Path(path).read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            k, sep, v = line.partition("=")
            if not sep:
                raise Refused(f"{path}: строка без «=»: {line!r}")
            conf[k.strip()] = v.strip()
    return conf


def usbip_target(conf):
    """→ (host, port) или Refused. Только IPv4-литерал из LAB_NET; порт 1..65535."""
    try:
        host = ipaddress.IPv4Address(conf.get("SHCAM_HOST", ""))
        net = ipaddress.IPv4Network(conf.get("LAB_NET", ""), strict=True)
        port = int(conf.get("SHCAM_USBIP_PORT", "3240"))
    except ValueError as e:
        raise Refused(f"lab-video.conf: {e}") from e
    if host not in net or not net.is_private:
        raise Refused(f"SHCAM_HOST {host} вне LAB_NET {net} (или сеть не частная)")
    if not 0 < port < 65536:
        raise Refused(f"SHCAM_USBIP_PORT {port}")
    return str(host), port


def usbip_start(slot, conf, run_dir):
    host, port = usbip_target(conf)
    vport = usbip_attach.attach(host, port, SLOTS[slot])
    (run_dir / "port").write_text(f"{vport}\n")


def usbip_stop(run_dir):
    f = run_dir / "port"
    if not f.exists():
        return                                  # не подключали (или start не удался)
    vport = int(f.read_text())
    try:
        usbip_attach.detach(vport)
    except SystemExit as e:                     # порт уже свободен: устройство «выдернули» со стороны shcam
        print(f"detach: {e}", file=sys.stderr)
    f.unlink()


def vivid(action):
    cmd = ["modprobe", "vivid"] if action == "start" else ["modprobe", "-r", "vivid"]
    subprocess.run(cmd, check=True)
    if action == "start":
        subprocess.run(["udevadm", "settle", "--timeout=10"], check=False)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="what", required=True)
    v = sub.add_parser("vivid")
    v.add_argument("action", choices=["start", "stop"])
    u = sub.add_parser("usbip")
    u.add_argument("action", choices=["start", "stop"])
    u.add_argument("slot", choices=sorted(SLOTS))
    ap.add_argument("--config", default=str(CONF), help=argparse.SUPPRESS)   # для проверки вне образа
    a = ap.parse_args(argv)
    if os.geteuid() != 0:
        print("sheregesh-lab-video: только от root (юнитом systemd)", file=sys.stderr)
        return 2
    try:
        if a.what == "vivid":
            vivid(a.action)
        else:
            run_dir = Path(os.environ.get("RUNTIME_DIRECTORY", f"/run/sheregesh-lab-usbip-{a.slot}").split(":")[0])
            run_dir.mkdir(parents=True, exist_ok=True)
            if a.action == "start":
                usbip_start(a.slot, read_conf(a.config), run_dir)
            else:
                usbip_stop(run_dir)
    except Refused as e:
        print(f"sheregesh-lab-video: отказ: {e}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
