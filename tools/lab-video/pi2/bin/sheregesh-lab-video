#!/usr/bin/python3 -I
# SPDX-FileCopyrightText: 2026 Sheregesh contributors
# SPDX-License-Identifier: GPL-3.0-or-later
"""Помощник root для лабораторных источников видео блока (только dev-образ; п. 7 tools/lab-video).

Запускается только юнитами systemd с фиксированными аргументами; sheregesh-ui вызывает его не напрямую, а через
polkit — «start/stop/restart» перечисленных юнитов (51-sheregesh-lab-video.rules). Параметров от пользователя нет.

  sheregesh-lab-video vivid start|stop          загрузить / выгрузить vivid (параметры — /etc/modprobe.d)
  sheregesh-lab-video usbip start|stop SLOT     подключить / отключить устройство эмулятора shcam
                                                SLOT: hdmi (1-1, 534d:2109) | cvbs (1-2, 534d:0021) | camera (1-3, 1d6b:0102)

USB/IP подключается только к SHCAM_HOST из /etc/sheregesh/lab-video.conf (root), и только если это IPv4 из
LAB_NET: подключённое по сети USB-устройство попадает в USB-стек ядра, поэтому сервер задаётся образом, а не
пользователем. Защита от подменённого сервера (LAB-SECURITY LS-1):
  - до attach: заявленный сервером VID:PID должен совпасть со слотом;
  - после attach: VID:PID и классы интерфейсов в sysfs — тоже (только 0e, видео), иначе немедленный detach;
  - интерфейсы на шине vhci по умолчанию не авторизованы (98-sheregesh-lab-usbip.rules), udev разрешает только класс 0e.
Состояние слота — $RUNTIME_DIRECTORY/state.json (порт vhci, devid, VID:PID): stop отключает порт, только если на нём
всё ещё это устройство (LS-2: после «выдернуть» со стороны shcam порт мог занять другой слот). Выбор порта и
attach/detach — под flock на каталоге контроллера vhci (LS-3: одновременный start двух слотов).
"""
import argparse
import fcntl
import ipaddress
import json
import os
import subprocess
import sys
import time
from contextlib import contextmanager
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import usbip_attach  # noqa: E402  (рядом в /usr/lib/sheregesh/lab-video)

CONF = Path("/etc/sheregesh/lab-video.conf")
USB_DEVICES = Path("/sys/bus/usb/devices")
SLOTS = {"hdmi": ("1-1", "534d:2109"), "cvbs": ("1-2", "534d:0021"), "camera": ("1-3", "1d6b:0102")}
VIDEO_CLASS = "0e"
SETTLE_S = 5.0


class Refused(Exception):
    pass


def read_conf(path):
    conf = {}
    for line in Path(path).read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            k, sep, v = line.partition("=")
            if not sep:
                raise Refused(f"{path}: строка без «=»: {line!r}")
            conf[k.strip()] = v.strip()
    return conf


def usbip_target(conf):
    """→ (host, port) или Refused. Только IPv4-литерал из LAB_NET; порт 1..65535."""
    try:
        host = ipaddress.IPv4Address(conf.get("SHCAM_HOST", ""))
        net = ipaddress.IPv4Network(conf.get("LAB_NET", ""), strict=True)
        port = int(conf.get("SHCAM_USBIP_PORT", "3240"))
    except ValueError as e:
        raise Refused(f"lab-video.conf: {e}") from e
    if host not in net or not net.is_private:
        raise Refused(f"SHCAM_HOST {host} вне LAB_NET {net} (или сеть не частная)")
    if not 0 < port < 65536:
        raise Refused(f"SHCAM_USBIP_PORT {port}")
    return str(host), port


@contextmanager
def vhci_lock():
    """Эксклюзивная блокировка на каталоге контроллера vhci (flock на sysfs-каталоге; общий для всех слотов)."""
    fd = os.open(usbip_attach.ensure_vhci(), os.O_RDONLY | os.O_DIRECTORY)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def read_attr(path):
    try:
        return path.read_text().strip()
    except OSError:
        return None


def check_attached(vport, devid, expect, timeout=SETTLE_S):
    """После attach: на порту наше устройство (devid), его VID:PID = слот, у интерфейсов только класс 0e.
    → None или причина отказа."""
    deadline = time.monotonic() + timeout
    while True:
        p = usbip_attach.port_info(vport)
        busid = p["local_busid"] if p and p["devid"] == devid else ""
        dev = USB_DEVICES / busid if busid and busid != "0-0" else None
        if dev and (dev / "idVendor").exists():
            got = f"{read_attr(dev / 'idVendor')}:{read_attr(dev / 'idProduct')}"
            if got != expect:
                return f"на порту {vport} {got}, ожидался {expect}"
            classes = {read_attr(i / "bInterfaceClass") for i in dev.parent.glob(f"{busid}:*")}
            if not classes:
                if time.monotonic() < deadline:
                    time.sleep(0.1)
                    continue
                return f"у {busid} нет интерфейсов"
            if classes != {VIDEO_CLASS}:
                return f"у {busid} интерфейсы классов {sorted(classes)} — разрешён только {VIDEO_CLASS}"
            return None
        if time.monotonic() >= deadline:
            return f"устройство на порту {vport} не появилось за {timeout:.0f} с"
        time.sleep(0.1)


def usbip_start(slot, conf, run_dir, check=check_attached):
    host, port = usbip_target(conf)
    busid, expect = SLOTS[slot]
    with vhci_lock():
        try:
            d = usbip_attach.import_device(host, port, busid, expect)
        except SystemExit as e:
            raise Refused(str(e)) from e
    state = {"vport": d["vport"], "devid": d["devid"], "expect": expect, "busid": busid}
    (run_dir / "state.json").write_text(json.dumps(state) + "\n")
    why = check(d["vport"], d["devid"], expect)
    if why:
        usbip_stop(run_dir)
        raise Refused(f"{slot}: {why} — отключено")
    print(f"attached {slot} ({busid} {expect}) -> vhci port {d['vport']}")


def usbip_stop(run_dir):
    f = run_dir / "state.json"
    if not f.exists():
        return                                  # не подключали (или start не удался до attach)
    state = json.loads(f.read_text())
    with vhci_lock():
        p = usbip_attach.port_info(state["vport"])
        if p and p["sta"] != usbip_attach.VDEV_ST_NULL and p["devid"] == state["devid"]:
            usbip_attach.detach(state["vport"])
        else:                                   # «выдернули» со стороны shcam; порт свободен или уже чужой
            now = "нет порта" if p is None else "свободен" if p["sta"] == usbip_attach.VDEV_ST_NULL \
                else f"занят devid {p['devid']:#x}, наш {state['devid']:#x}"
            print(f"port {state['vport']}: {now} — не отключаю", file=sys.stderr)
    f.unlink()


def vivid(action):
    cmd = ["modprobe", "vivid"] if action == "start" else ["modprobe", "-r", "vivid"]
    subprocess.run(cmd, check=True)
    if action == "start":
        subprocess.run(["udevadm", "settle", "--timeout=10"], check=False)


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    sub = ap.add_subparsers(dest="what", required=True)
    v = sub.add_parser("vivid")
    v.add_argument("action", choices=["start", "stop"])
    u = sub.add_parser("usbip")
    u.add_argument("action", choices=["start", "stop"])
    u.add_argument("slot", choices=sorted(SLOTS))
    ap.add_argument("--config", default=str(CONF), help=argparse.SUPPRESS)   # для проверки вне образа
    a = ap.parse_args(argv)
    if os.geteuid() != 0:
        print("sheregesh-lab-video: только от root (юнитом systemd)", file=sys.stderr)
        return 2
    try:
        if a.what == "vivid":
            vivid(a.action)
        else:
            run_dir = Path(os.environ.get("RUNTIME_DIRECTORY", f"/run/sheregesh-lab-usbip-{a.slot}").split(":")[0])
            run_dir.mkdir(parents=True, exist_ok=True)
            if a.action == "start":
                usbip_start(a.slot, read_conf(a.config), run_dir)
            else:
                usbip_stop(run_dir)
    except Refused as e:
        print(f"sheregesh-lab-video: отказ: {e}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
