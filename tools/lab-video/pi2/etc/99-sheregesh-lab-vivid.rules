# Постоянные имена узлов vivid (номера /dev/videoN меняются; by-path у двух экземпляров vivid совпадает).
# DRIVERS=="vivid" (LS-4): имя узла задаёт драйвер, UVC-устройство по USB/IP может назваться так же.
SUBSYSTEM=="video4linux", DRIVERS=="vivid", ATTR{name}=="vivid-000-vid-cap", SYMLINK+="sheregesh-lab/cvbs-cap"
SUBSYSTEM=="video4linux", DRIVERS=="vivid", ATTR{name}=="vivid-000-vid-out", SYMLINK+="sheregesh-lab/cvbs-out"
SUBSYSTEM=="video4linux", DRIVERS=="vivid", ATTR{name}=="vivid-001-vid-cap", SYMLINK+="sheregesh-lab/hdmi-cap"
SUBSYSTEM=="video4linux", DRIVERS=="vivid", ATTR{name}=="vivid-001-vid-out", SYMLINK+="sheregesh-lab/hdmi-out"
