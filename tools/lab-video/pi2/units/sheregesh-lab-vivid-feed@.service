# Лабораторный dev-образ: подача потока камеры shcam (SHCAM_RTSP) в выход vivid, %i = cvbs | hdmi
# (lab-vivid отвергает другие имена). Без root: sheregesh-ui в группе video. Декодер — v4l2h264dec (Pi 4).
[Unit]
Description=Sheregesh lab: feed shcam camera into vivid %i input (dev image only)
ConditionPathExists=/etc/sheregesh/DEV-MODE
ConditionPathExists=/etc/sheregesh/lab-video.conf
Requires=sheregesh-lab-vivid.service
After=sheregesh-lab-vivid.service network-online.target
Wants=network-online.target
PartOf=sheregesh-lab-vivid.service

[Service]
User=sheregesh-ui
ExecStart=/usr/lib/sheregesh/lab-video/lab-vivid feed %i
Restart=always
RestartSec=2
Nice=10
CacheDirectory=sheregesh-lab-vivid-feed
Environment=GST_REGISTRY=/var/cache/sheregesh-lab-vivid-feed/registry.bin PYTHONDONTWRITEBYTECODE=1
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
# Сеть стенда (= LAB_NET в /etc/sheregesh/lab-video.conf); другой сети — поправить вместе с конфигом.
IPAddressDeny=any
IPAddressAllow=192.168.1.0/24
