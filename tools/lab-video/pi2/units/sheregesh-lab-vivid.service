# Лабораторный dev-образ: эмулированные входы захвата vivid (аналог CVBS PAL/NTSC, HDMI) — tools/lab-video/pi2.
# Root нужен только для modprobe; polkit разрешает sheregesh-ui start/stop/restart (51-sheregesh-lab-video.rules).
# stop выгружает vivid: подачи (PartOf) останавливаются раньше; если узел держит видеоприём блока, выгрузка
# откажет — сначала вернуть блок на другой источник.
[Unit]
Description=Sheregesh lab: vivid emulated capture inputs (dev image only)
ConditionPathExists=/etc/sheregesh/DEV-MODE
After=systemd-udevd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/sheregesh/lab-video/sheregesh-lab-video vivid start
ExecStartPost=/usr/lib/sheregesh/lab-video/lab-vivid init
ExecStop=/usr/lib/sheregesh/lab-video/sheregesh-lab-video vivid stop
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
# LS-7: из привилегий root остаётся только загрузка модулей; запись в sysfs/узлы — по правам владельца-root
CapabilityBoundingSet=CAP_SYS_MODULE
AmbientCapabilities=
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# vivid не пишет в /sys; ProtectKernelModules нельзя — нужен modprobe
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
Environment=PYTHONDONTWRITEBYTECODE=1
