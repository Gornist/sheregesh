#!/bin/bash
# SPDX-FileCopyrightText: 2026 Sheregesh contributors
# SPDX-License-Identifier: GPL-3.0-or-later
# Подача картинки в выход vivid (петля на эмулированный вход): shcam-feed cvbs | hdmi
# Формат берётся с узла: cvbs — по текущему стандарту (PAL 720x576i25 / NTSC 720x480i29.97, чересстрочно),
# hdmi — по текущим DV timings. Источник — SHCAM_FEED_SRC (поток камеры rtsp://127.0.0.1:8554/cam или «test»).
# Поверх — метка времени, чтобы на пульте было видно, что картинка живая и с какого входа.
set -euo pipefail

DEV=/dev/shcam
SRC_URL=${SHCAM_FEED_SRC:-rtsp://127.0.0.1:8554/cam}
case $SRC_URL in
    rtsp://*) SRC="rtspsrc location=$SRC_URL protocols=tcp latency=0 ! rtph264depay ! h264parse ! avdec_h264" ;;
    test)     SRC="videotestsrc is-live=true pattern=smpte" ;;
    *) echo "shcam-feed: SHCAM_FEED_SRC — rtsp://… или test: $SRC_URL" >&2; exit 2 ;;
esac
SRC="$SRC ! videoconvert ! videoscale add-borders=false ! videorate"

case ${1:-} in
    cvbs)
        std=$(v4l2-ctl -d $DEV/cvbs-out --get-standard | awk '/Video Standard/ {print $4; exit}')
        if (( std & 0xff )); then  # PAL: 50 полей/с → 25 кадров, верхнее поле первым; PAR 54/59
            w=720 h=576 fields=50/1 rate=25/1 par=54/59 tff=true label="CVBS PAL"
        else                       # NTSC: 59.94 полей/с → 29.97 кадров, нижнее поле первым; PAR 11/10
            w=720 h=480 fields=60000/1001 rate=30000/1001 par=11/10 tff=false label="CVBS NTSC"
        fi
        # capssetter убирает field-order: иначе v4l2sink ставит выходу Interlaced-TB/BT, а вход vivid — Interlaced,
        # поля не совпадают и петля отдаёт шум вместо картинки.
        exec gst-launch-1.0 -q $SRC ! "video/x-raw,width=$w,height=$h,framerate=$fields,pixel-aspect-ratio=$par" \
            ! timeoverlay text="$label" halignment=right valignment=bottom font-desc="Sans 20" \
            ! videoconvert ! "video/x-raw,format=YUY2" ! interlace field-pattern=1:1 top-field-first=$tff \
            ! capssetter replace=true \
                caps="video/x-raw,format=YUY2,width=$w,height=$h,framerate=$rate,interlace-mode=interleaved,pixel-aspect-ratio=$par" \
            ! v4l2sink device=$DEV/cvbs-out sync=false ;;
    hdmi)
        read -r w h fps < <(v4l2-ctl -d $DEV/hdmi-out --get-dv-timings | awk '
            /Active width/ {w=$3} /Active height/ {h=$3}
            /Pixelclock/ {sub(/.*\(/, ""); sub(/ frames.*/, ""); f=$0} END {print w, h, f}')
        rate=$(awk -v f="$fps" 'BEGIN { r=int(f+0.5); if (r-f > 0.005) print r*1000 "/1001"; else print r "/1" }')
        exec gst-launch-1.0 -q $SRC ! "video/x-raw,width=$w,height=$h,framerate=$rate" \
            ! timeoverlay text="HDMI ${w}x${h}" halignment=right valignment=bottom font-desc="Sans 24" \
            ! videoconvert ! "video/x-raw,format=YUY2" ! v4l2sink device=$DEV/hdmi-out sync=false ;;
    *) echo "usage: shcam-feed cvbs|hdmi" >&2; exit 2 ;;
esac
