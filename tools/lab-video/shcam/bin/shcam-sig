#!/bin/bash
# SPDX-FileCopyrightText: 2026 Sheregesh contributors
# SPDX-License-Identifier: GPL-3.0-or-later
# Эмулированные входы на shcam: обёртка над lab-vivid (та же реализация, что на pi2) + сбои эмулятора USB/IP.
#
#   shcam-sig init                         после загрузки (shcam-vivid-setup.service): петли, стандарт и режим
#                                          из /etc/default/shcam-video, без OSD
#   shcam-sig status                       стандарт, режим HDMI, сигнал, подключение, подачи, эмулятор USB/IP
#   shcam-sig cvbs|hdmi ok|nosignal|nolock|cable-out|testpattern
#   shcam-sig hdmi outofrange
#   sudo shcam-sig cvbs pal|ntsc           сменить стандарт (подача shcam-feed@cvbs перезапускается)
#   sudo shcam-sig hdmi 1920x1080p30       сменить режим HDMI (подача @hdmi перезапускается)
#   shcam-sig usb PROFILE ok|blue|black|freeze|unplug
#                                          устройства эмулятора USB/IP (hdmi-ms2109, cvbs-ms2106, camera);
#                                          unplug разрывает USB/IP — хост видит отключение USB
#
# Что при этом видит V4L2 — tools/lab-video/CONTRACT.md.
set -euo pipefail

LIB=/usr/local/lib/shcam
DEFAULTS=/etc/default/shcam-video
# shellcheck source=/dev/null
[ -r "$DEFAULTS" ] && . "$DEFAULTS"
export LAB_VIVID_FEED_UNIT='shcam-feed@{}.service'
lab_vivid() { /usr/bin/python3 -I "$LIB/lab-vivid" "$@"; }
die() { echo "shcam-sig: $*" >&2; exit 1; }

case ${1:-status} in
    init) lab_vivid init --std "${SHCAM_CVBS_STD:-pal}" --hdmi "${SHCAM_HDMI_MODE:-1280x720p30}"; lab_vivid status ;;
    status)
        lab_vivid status
        echo "usbip-uvc: $(systemctl is-active shcam-usbip-uvc || true)"
        for s in /run/shcam-uvc/*.signal; do [ -e "$s" ] && echo "      $(basename "$s" .signal): $(cat "$s")"; done
        true ;;
    usb)
        [[ ${2:-} =~ ^(hdmi-ms2109|cvbs-ms2106|camera)$ ]] || die "профиль USB: hdmi-ms2109 | cvbs-ms2106 | camera"
        [[ ${3:-} =~ ^(ok|blue|black|freeze|unplug)$ ]] || die "сигнал USB: ok | blue | black | freeze | unplug"
        echo "$3" > "/run/shcam-uvc/$2.signal" ;;
    cvbs|hdmi) lab_vivid "$@" ;;
    -h|--help) sed -n '4,17p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "неизвестная команда: $1 (shcam-sig --help)" ;;
esac
