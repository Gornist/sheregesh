# shcam: начальная настройка эмулированных входов vivid после загрузки (петли, стандарт, режим HDMI).
[Unit]
Description=shcam: vivid emulated capture inputs (CVBS, HDMI)
After=systemd-modules-load.service systemd-udev-settle.service systemd-udevd.service
Wants=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/shcam-sig init

[Install]
WantedBy=multi-user.target
